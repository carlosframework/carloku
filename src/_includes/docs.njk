{#
  🤖 The documentation shell: sidebar, section sub-nav, article column.

  One layout serves the index and every page, because they share the
  whole chrome. Zero client-side JavaScript beyond site.js's existing
  enhancements (both no-ops here, guarded by querySelector) — there is
  no search box, and findability is the nav, the card index, and the
  per-page section list.

  The sidebar precedes the article in document order, which on a narrow
  viewport is what puts the nav above the content without a toggle.

  The sidebar is a <nav>, not an <aside>: with no search, it IS this
  site's whole navigation model, not supplementary content. The article
  is wrapped in <main> so the skip link (first focusable element in
  <body>) has a landmark to target — with dozens of sidebar links ahead
  of it on every page, a keyboard user needs a way past them.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} &mdash; Carloku docs</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e0c13" media="(prefers-color-scheme: dark)">
<meta property="og:title" content="{{ title }} &mdash; Carloku docs">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="https://carloku.com/docs/{% if not isIndex %}{{ docsSlug }}/{% endif %}">
<link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/site.css">
<link rel="stylesheet" href="/docs.css">
</head>
<body class="docs-body">
<a class="skip" href="#main">Skip to content</a>
<p class="brandline"><a href="/"><b>Carloku</b></a> <span aria-hidden="true">/</span> <span class="here">docs</span><span class="folio" aria-hidden="true">carloku.com/docs</span></p>

<div class="docs-shell">
  <nav class="docs-nav" aria-label="Documentation">
    <p class="docs-nav-title"><a href="/docs/"{% if isIndex %} class="active" aria-current="page"{% endif %}>Documentation</a></p>
    {% for section in docsnav.sections %}
    <p class="docs-nav-section">{{ section.title }}</p>
    <ul>
      {% for entry in section.pages %}
      <li>
        <a href="/docs/{{ entry.slug }}/"{% if entry.slug == docsSlug %} class="active" aria-current="page"{% endif %}>{{ entry.label }}</a>
        {% if entry.slug == docsSlug %}
        {% set sections = collections.docs | docsRawFor(docsSlug) | docsSections %}
        {% if sections.length %}
        <ul class="docs-subnav">
          {% for s in sections %}<li><a href="#{{ s.anchor }}">{{ s.title }}</a></li>{% endfor %}
        </ul>
        {% endif %}
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endfor %}
  </nav>

  <main id="main">
    <article class="docs-article">
      {{ content | safe }}

      {% if not isIndex %}
      <p class="docs-foot">
        <a href="/docs/{{ docsSlug }}.md">Read this page as markdown</a> &mdash;
        exact, unstyled, and cheap for an agent to fetch.
      </p>
      {% endif %}
    </article>
  </main>
</div>

<footer class="docs-sitefoot">
  <p>🤖 These pages were written by an LLM, on the ideas, instruction, and editing of humans. AI-written text here is always marked, visibly &mdash; that's <a href="https://11factor.org/#x">factor X</a>.</p>
  <p class="docs-provenance">These pages are written and maintained in the <a href="https://github.com/carlosframework/carloku">carloku</a> repo, alongside the rest of this site.</p>
</footer>
<script src="/site.js" defer></script>
</body>
</html>
