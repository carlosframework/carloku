    {
      "id": "member.p1",
      "text": "Members are team members who can access and ship your sites and apps.",
      "original": "Members are team members who can access and ship your sites and apps.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "member.p2",
      "text": "Inclusions are per member, per month. They are pooled across the account and do not roll over.",
      "original": "Inclusions are per member, per month. They are pooled across the account and do not roll over.",
      "edited": false,
      "rerolled": false,
