    {
      "id": "bands.heading",
      "text": "Indexed pricing",
      "original": "Indexed pricing",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "bands.p1",
      "text": "Prices are indexed to local affordability, using a World Bank price-level measure for your billing country. There are four bands.",
      "original": "Prices are indexed to local affordability, using a World Bank price-level measure for your billing country. There are four bands.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "bands.a",
      "text": "Band A pays the full price and gets the full inclusions.",
      "original": "Band A pays the full price and gets the full inclusions.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "bands.b",
      "text": "Band B pays 75% and gets 75% of the inclusions.",
      "original": "Band B pays 75% and gets 75% of the inclusions.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "bands.c",
      "text": "Band C pays 50% and gets 50%.",
      "original": "Band C pays 50% and gets 50%.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "bands.d",
      "text": "Band D pays 35% and gets 35%.",
      "original": "Band D pays 35% and gets 35%.",
