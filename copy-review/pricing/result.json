      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "over.p3",
      "text": "Carloku is hosting (currently) on AWS. For files served directly from S3, we simply charge the AWS transfer fee.",
      "original": "Carloku is hosting (currently) on AWS. For files served directly from S3, we simply charge the AWS transfer fee.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "half.heading",
      "text": "No questions asked discounts",
      "original": "Half price for anyone",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "half.p1",
      "text": "We don't have a sales team and we don't want one. We'd rather you paid the full price, but in case you can't (or won't), use discount \"HALF\" to get an instant 50% reduction. No negotiation required.",
      "original": "Use the code HALF at checkout for 50% off the subscription, forever. No form, no proof. The inclusions are not halved.",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "promise.heading",
      "text": "The promise",
      "original": "What we promise",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "promise.p1",
      "text": "Prices are fixed for a year. We’ll review pricing bands annually. Any changes apply to new subscriptions. You keep your deal until you decide to change.",
      "original": "Your price is fixed for the year you bought. Rates and country bands are reviewed once a year, in public. Any tightening applies to new subscriptions only. Existing accounts keep the deal they signed up for until they choose to change it.",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "pay.heading",
      "text": "Taxes etc.",
      "original": "Tax, paying and cancelling",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "pay.p1",
      "text": "Prices exclude value-added tax (VAT). VAT is added at checkout according to your billing country and shown before you pay. The merchant is Team Tito Limited, Dublin, Ireland.",
      "original": "Prices exclude value-added tax (VAT). VAT is added at checkout according to your billing country and shown before you pay. The merchant is Team Tito Limited, Dublin, Ireland.",
      "edited": false,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "pay.p2",
      "text": "Stripe handles payments, and you can manage your subscription via the portal they provide.",
      "original": "You pay by card through Stripe. From your account's Billing page you can change your card, download invoices and cancel. Cancelling keeps the plan running until the end of the year you paid for.",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "pay.p3",
      "text": "Members on Community or Business accounts are charged immediately, prorated to the day that year. If a member is removed, it comes off the bill at renewal time.",
      "original": "Adding a member to Community or Business charges the rest of the current year for that member straight away, prorated to the day. A member who leaves comes off the bill at renewal.",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
    {
      "id": "pay.p4",
      "text": "Billing details stored securely by Stripe, not by us.",
      "original": "We keep no card details, billing name or billing address on our side.",
      "edited": true,
      "rerolled": false,
      "rerolls": [],
      "done": false
    },
